# Copy to .env and fill in. Never put secrets in browser code (js/, partials/).

# Server
PORT=3000
NODE_ENV=development            # set to production when deployed (enables secure cookies, HTTPS upgrade)
SESSION_SECRET=                 # required in production: long random string, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`

# Admin panel (/admin). Leave empty to disable admin login. Password must be 12+ characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Ask Mkulima AI (server side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AI_RATE_LIMIT_PER_HOUR=20

# Optional
# DB_PATH=./mkulima.db
